-- --- FUNÇÕES CORE DO SKYBOX ---

local function RestoreSkin()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and remotes:FindFirstChild("ResetCharacterAppearance") then
        pcall(function()
            remotes.ResetCharacterAppearance:FireServer()
        end)
    end
end

local function ApplySkybox()
    if skyActive then return end
    skyActive = true

    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")

    pcall(function()
        if remotes and remotes:FindFirstChild("ChangeCharacterBody") then
            local bodyParts = {
                ASSETS.TORSO,
                ASSETS.RIGHT_LEG,
                ASSETS.LEFT_LEG,
                ASSETS.LEFT_ARM,
                ASSETS.RIGHT_ARM,
                ASSETS.HEAD
            }
            remotes.ChangeCharacterBody:InvokeServer(bodyParts)
        end

        if animator then
            local anim = Instance.new("Animation")
            anim.AnimationId = ASSETS.ANIM_ID
            currentTrack = animator:LoadAnimation(anim)
            currentTrack.Priority = Enum.AnimationPriority.Action4
            currentTrack.Looped = true
            currentTrack:Play()
        end
    end)

    RemoveBtn.BorderColor3 = Color3.fromRGB(255, 255, 255)
end

local function RemoveSkybox()
    if not skyActive then return end
    skyActive = false

    if currentTrack then
        currentTrack:Stop()
        currentTrack = nil
    end

    RestoreSkin()

    RemoveBtn.BorderColor3 = Color3.fromRGB(60, 60, 60)
end

-- Função para encerrar e destruir o script 100%
local function ShutdownScript()
    skyActive = false
    if currentTrack then
        currentTrack:Stop()
        currentTrack = nil
    end
    
    RestoreSkin()
    
    if renderConnection then
        renderConnection:Disconnect()
    end
    
    ScreenGui:Destroy()
end

